root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# The shell style the repository is formatted in, so that a bare `shfmt` — an
# editor on save, or a hook — agrees with the options `dyshellint` passes.
[*.{sh,bash,bats}]
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = true
