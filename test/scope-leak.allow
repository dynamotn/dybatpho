# Reviewed functions that `test/scope-leak.awk` flags but that cannot let a
# caller's code or a caller's variable name reach their plain locals.
# `test/conventions.bats` fails on any flagged function not listed here.
#
# Format: file<TAB>function<TAB>mode<TAB>reason. A function is listed whole:
# give the reason it is safe, and prefix the locals instead when no reason holds.
# The mode says whether the function still runs its caller's code, so that the
# functions handing code on to it are flagged in turn: `spread` when it does
# (its plain locals are deliberate), `stop` when it runs only code it trusts.

init.sh	__dybatpho_export_functions	stop	evaluates the export list it builds itself from `declare -F`
src/cli.sh	__dybatpho_cli_collect_spec_metadata	spread	its `__` locals are the spec DSL's context, read on purpose by `dybatpho::opts::*`
src/cli.sh	__dybatpho_cli_generate_help	spread	its `__` locals are the spec DSL's context, read on purpose by `dybatpho::opts::*`
src/cli.sh	__dybatpho_cli_generate_logic	spread	its `__` locals are the spec DSL's context, and `IFS` is set on purpose for the DSL's word splitting
src/cli.sh	__dybatpho_cli_replay_persistent_defs	spread	its `__` locals are the spec DSL's context, read on purpose by `dybatpho::opts::*`
src/cli.sh	dybatpho::opts::cmd	spread	its `__` locals are the spec DSL's context, read on purpose by `dybatpho::opts::*`
src/file.sh	__dybatpho_file_rewrite	stop	runs only the module's own producers, which keep prefixed locals
src/forge.sh	__dybatpho_forge_or_die	stop	runs only the module's own requests
src/helpers.sh	__dybatpho_helpers_locate	stop	evaluates only the `shopt -p` line it saved itself
src/helpers.sh	__dybatpho_helpers_sort	stop	`LC_ALL=C` is local on purpose so a comparator compares bytes
src/helpers.sh	dybatpho::expect_ref	stop	only checks the name it is given; it binds nothing to it
src/json.sh	__dybatpho_json_emit	stop	runs only the module's own producers
src/logging.sh	dybatpho::start_trace	stop	the trap command runs at exit, after this function has returned
src/network.sh	__dybatpho_network_with_secret_headers	stop	scopes `DYBATPHO_CURL_SECRET_HEADERS` to the call on purpose, so the command sees the added header
src/notification.sh	dybatpho::notify_email	stop	runs the sendmail program, which cannot see shell variables
src/privilege.sh	__dybatpho_privilege_keepalive	stop	runs the escalation program, which cannot see shell variables
src/process.sh	__dybatpho_process_timeout_fallback	stop	its plain locals are declared after the command has started in the background
src/screen.sh	dybatpho::screen_table	stop	copies the caller's rows before declaring any plain local
src/notification.sh	dybatpho::notify_desktop	stop	runs `notify-send` or `osascript`, programs that cannot see shell variables
src/pkg.sh	__dybatpho_pkg_run	stop	runs the package-manager command the module builds itself
src/release.sh	dybatpho::release_sign	stop	runs the configured signing program on two quoted paths
src/cli.sh	__dybatpho_cli_collect_long_switches	spread	its `__` locals are the spec DSL's context, read on purpose by `dybatpho::opts::*`
src/cli.sh	__dybatpho_cli_generate_child_logic	spread	its `__` locals are the spec DSL's context, read on purpose by `dybatpho::opts::*`
src/cli.sh	dybatpho::generate_help	spread	its `__` locals are the spec DSL's context, read on purpose by `dybatpho::opts::*`
